# Copy this file to `.env` and fill in real values for local development.
# NEVER commit a `.env` file with real credentials.

# PostgreSQL connection string.
DATABASE_URL=postgres://user:password@localhost:5432/lexhack

# Interface the HTTP server binds to.
HOST=0.0.0.0

# Port the HTTP server binds to.
PORT=3000

# Log verbosity (see https://docs.rs/tracing-subscriber EnvFilter syntax).
RUST_LOG=info

# Maximum number of connections in the Postgres pool. Optional, defaults to 5.
DATABASE_MAX_CONNECTIONS=5

# ---------------------------------------------------------------------------
# Authentication (PART 03)
# ---------------------------------------------------------------------------
# All values below are optional; the defaults shown are what the server uses
# when the variable is absent. Changing any of these requires a restart.

# Session lifetime, in seconds. Default: 7 days.
SESSION_LIFETIME_SECONDS=604800

# Argon2id cost parameters (OWASP-recommended defaults):
#   ARGON2_M_COST — memory, in KiB. Default: 19456 (19 MiB).
#   ARGON2_T_COST — iterations. Default: 2.
#   ARGON2_P_COST — parallelism. Default: 1.
# Lowering these weakens password hashing. Do not change without a
# documented reason.
ARGON2_M_COST=19456
ARGON2_T_COST=2
ARGON2_P_COST=1

# Rate limiting (per source IP address).
#   RATE_LIMIT_LOGIN_PER_MINUTE   — login attempts per minute. Default: 5.
#   RATE_LIMIT_REGISTER_PER_HOUR  — registrations per hour. Default: 3.
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=3

# ---------------------------------------------------------------------------
# AI contract analysis (PART 05)
# ---------------------------------------------------------------------------
# The AI provider is OpenAI-compatible. Any endpoint that speaks the
# OpenAI chat completions protocol works: OpenAI itself, Gemini's
# OpenAI-compatible routing, OpenRouter, Ollama, vLLM, ...
#
# AI_API_KEY is OPTIONAL. The server starts without it; every call to
# POST /api/contracts/:id/analyze returns 502 until it is set. Never
# commit a real key to source control.
#
#   AI_BASE_URL          — provider base URL. Default: https://api.openai.com
#   AI_MODEL             — model identifier.  Default: gpt-4o-mini
#   AI_TIMEOUT_SECONDS   — per-request HTTP timeout. Default: 60
#   AI_MAX_INPUT_CHARS   — max contract text bytes. Default: 100000
#   AI_MAX_RETRIES       — retries for retryable failures. Default: 2

# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com
# AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60
AI_MAX_INPUT_CHARS=100000
AI_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Background worker & notifications (PART 07)
# ---------------------------------------------------------------------------
# The worker polls for due reminders and dispatches them through the
# channels configured below. All values are optional; the defaults are
# shown.

WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=10
WORKER_BATCH_SIZE=50
WORKER_MAX_CONCURRENCY=8
WORKER_CLAIM_TIMEOUT_SECONDS=300
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
NOTIFICATION_REQUEST_TIMEOUT_SECONDS=15
NOTIFICATION_MAX_RETRIES=5

# Telegram (leave unset to disable Telegram delivery)
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF
# TELEGRAM_CHAT_ID=-1001234567890

# Discord webhook (leave unset to disable Discord delivery)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Generic webhook (leave unset to disable webhook delivery)
# WEBHOOK_URL=https://example.com/lexhack/hook

# TEST ONLY. Never enable this in production.
# WEBHOOK_ALLOW_LOOPBACK=false

# ---------------------------------------------------------------------------
# Security & notification channels (PART 08)
# ---------------------------------------------------------------------------
# NOTIFICATION_SECRET_KEY is REQUIRED in production. It must be a
# base64-encoded 32-byte key. Generate one with:
#
#     openssl rand -base64 32
#
# The server refuses to start without it - this prevents accidentally
# running without encrypted channel credentials.
# NOTIFICATION_SECRET_KEY=

# Per-user rate limits (authenticated endpoints).
RATE_LIMIT_ANALYZE_PER_HOUR=10
RATE_LIMIT_CHANNEL_TEST_PER_MINUTE=5
RATE_LIMIT_CHANNEL_MUTATION_PER_HOUR=20

# ---------------------------------------------------------------------------
# Frontend & CORS (PART 09)
# ---------------------------------------------------------------------------
# Comma-separated list of exact origins allowed to call this API from a
# browser. Wildcards (`*`) are rejected — every entry must include the
# scheme, host, and port. Defaults to the `trunk serve` dev origin.
#
# Production example:
# CORS_ALLOWED_ORIGINS=https://app.lexhack.example.com,https://admin.lexhack.example.com
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
